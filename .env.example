# ก๊อปเป็นไฟล์ชื่อ .env แล้วกรอกค่าของคุณเอง — ห้าม commit .env และห้ามวางค่าเหล่านี้ในแชทกับ AI

# --- RunningHub ---
RUNNINGHUB_API_KEY=
RUNNINGHUB_WORKFLOW_ID=          # workflow id ของ "Motion Context V2" บน RunningHub (ใส่ใน rh.*.config.json ก็ได้)
# RH_COIN_USD=                   # (ไม่บังคับ) ราคาต่อ 1 coin เป็น USD เพื่อคำนวณ cost_usd

# --- RunPod ---
RUNPOD_API_KEY=                  # ใช้ดู/หยุด pod และ --pod auto (RunPod ไม่มี workflow id: ใช้กราฟ API จาก templates)
# RUNPOD_COMFY_URL=              # (ไม่บังคับ) https://<pod-id>-8188.proxy.runpod.net — หรือส่ง --pod-url ทุกครั้ง

# --- Supabase (ไม่บังคับ: เก็บ ledger/prompt บนคลาวด์) ---
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=     # service_role เท่านั้น ใช้ในสคริปต์ในเครื่อง ห้ามใส่ frontend
